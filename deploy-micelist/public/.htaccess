# МАЙСЛИСТ — заглушка micelist.ru
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

# Перенаправлений здесь нет намеренно: http → https и www → micelist.ru
# включаются в ISPmanager после выпуска сертификата. HTTPS на REG.RU
# принимает nginx перед Apache, и такое правило в .htaccess может
# зациклиться, а до сертификата — привести посетителя к ошибке безопасности.

# Настройки с паролем, данные заявок и служебные файлы из браузера не открываются,
# даже если по ошибке окажутся в папке сайта.
<FilesMatch "^(micelist-mail.*\.php|.*\.csv|ratelimit\.json|keys\.txt|\.ht.*)$">
  Require all denied
</FilesMatch>
